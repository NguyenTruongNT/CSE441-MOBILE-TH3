# Pronunciation AI Proxy Server Configuration

# Server Port
PORT=8080

# Speech AI Provider: 'local-acoustic-gop', 'speechace', 'azure-speech', or 'google-speech'
SPEECH_PROVIDER=local-acoustic-gop

# Upstream API key (Optional - proxy runs standalone if omitted)
# SPEECH_API_KEY=your_upstream_api_secret_key_here

# Minimum score threshold for correct phonemes (default: 75.0)
PHONEME_CORRECT_THRESHOLD=75.0
